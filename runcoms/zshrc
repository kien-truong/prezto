# load custom zsh initialization
[ -f $HOME/.zsh_ext/zinit ] && source $HOME/.zsh_ext/zinit

# Source Prezto.
if [[ -s "${ZDOTDIR:-$HOME}/.zprezto/init.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprezto/init.zsh"
fi

# Customize to your needs...

# load local zshrc extension
[ -f $HOME/.zsh_ext/zshrc ] && source $HOME/.zsh_ext/zshrc
